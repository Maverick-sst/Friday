# ============================================================
# AI Commerce Strategy Team - environment configuration
# Copy to `.env` and fill values. NEVER commit the real .env.
# ============================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-only-secret-key-change-me-32b
WEB_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://agent_commerce:agent_commerce@localhost:5439/agent_commerce

# --- Redis (mission queue; empty = in-process fallback driver) ---
REDIS_URL=redis://localhost:6380/0

# --- Strategy-team LLM (OpenAI-compatible; fallback chain, comma-separated) ---
STRATEGY_LLM_BASE_URL=https://openrouter.ai/api/v1
STRATEGY_LLM_API_KEY=
STRATEGY_LLM_MODEL=stealth/ox-alpha
STRATEGY_LLM_FALLBACK_MODELS=z-ai/glm-5.2:free

# --- Tool plane (Composio; missing key -> deterministic mock plane) ---
COMPOSIO_API_KEY=
COMPOSIO_ENABLED=true

# --- Memory plane (Mem0; missing key -> local Postgres-backed adapter) ---
MEM0_API_KEY=

# --- Engine tuning (defaults match PRD_3 §23 bounds) ---
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=4
MAX_CONCURRENT_MISSIONS_GLOBAL=4
MAX_CONCURRENT_MISSIONS_PER_MERCHANT=2
MAX_AGENT_RUNS_PER_MISSION=25
MAX_SUB_AGENT_DEPTH=1
MAX_CHILDREN_PER_PARENT=5
AGENT_RUN_TIMEOUT_SECONDS=300
MISSION_TIMEOUT_SECONDS=900

# ============================================================
# Legacy V0 commerce gateway (preserved under the V0 nav section)
# ============================================================

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,write_draft_orders,read_shop
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/onboarding/shopify/callback
SHOPIFY_API_VERSION=2026-07

# --- Razorpay (TEST MODE keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Legacy buyer agent LLM (optional; scripted brain used when unset) ---
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
