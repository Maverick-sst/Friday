# ============================================================
# Agent Commerce Gateway - environment configuration
# Copy to `.env` and fill values. NEVER commit the real .env.
# ============================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Used to encrypt merchant credentials at rest (Fernet-derived). Change for real deployments.
SECRET_KEY=dev-only-secret-key-change-me-32b
WEB_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://agent_commerce:agent_commerce@localhost:5439/agent_commerce

# --- Shopify (public/custom app credentials from Partner Dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,write_draft_orders,read_shop
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/onboarding/shopify/callback
# Verify the current stable Admin GraphQL API version before demoing.
SHOPIFY_API_VERSION=2026-07

# --- Razorpay (TEST MODE keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Buyer agent LLM (optional; deterministic ScriptedBrain is used when unset) ---
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
